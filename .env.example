# ---------------------------------------------------------------- frontend
# These are compiled into the bundle and are PUBLIC. Anyone can read them in
# the browser devtools. That is fine and expected — security comes from the
# table permissions, not from hiding these values.
#
# Endpoint is region-specific — copy the exact one shown on your project's
# Settings page. A Singapore project 404s on the Sydney endpoint.
#   https://sgp.cloud.appwrite.io/v1   (Singapore)
#   https://syd.cloud.appwrite.io/v1   (Sydney)
#   https://fra.cloud.appwrite.io/v1   (Frankfurt)
#
# NOTE: Appwrite's own starter kit calls this VITE_APPWRITE_PROJECT_ID.
# This project reads VITE_APPWRITE_PROJECT (no _ID suffix). Do not copy the
# starter kit's variable names — the app will not find them.
VITE_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT=your-project-id
VITE_APPWRITE_DB=kirasihat

# Set to 1 to run the UI with no backend at all, reading data/seed-data.json.
# Handy for local work and for a demo when the project is unreachable.
VITE_MOCK=0

# ---------------------------------------------------------------- scripts only
# SERVER key. Used by scripts/setup-tables.mjs and scripts/seed.mjs.
# NEVER prefix this with VITE_ and never commit the real value —
# anything VITE_* is bundled into the public JavaScript.
APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
APPWRITE_PROJECT=your-project-id
APPWRITE_API_KEY=your-server-api-key
