{
  "name": "kirasihat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KiraSihat \u2014 turning official Malaysian mortality data into one safe preventive action. FIT5120 S2 2026, Team Dynamics (TM01).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "db:check": "node scripts/check-connection.mjs",
    "db:setup": "node scripts/setup-tables.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:reset": "node scripts/setup-tables.mjs --drop && node scripts/setup-tables.mjs && node scripts/seed.mjs",
    "build:mock": "vite build --mode mock --outDir dist-mock",
    "test": "npm run build:mock && node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "appwrite": "^26.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "dotenv": "^16.4.5",
    "jsdom": "^30.0.1",
    "node-appwrite": "^27.1.0",
    "vite": "^5.4.2"
  }
}
